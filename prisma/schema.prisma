datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String
  password     String
  experience   String?
  targetRole   String?
  phone        String?
  linkedin     String?
  portfolio    String?
  currentCTC   String?
  noticePeriod String?
  createdAt    DateTime         @default(now())
  applications Application[]
  companies    Company[]
  weeklyPlans  WeeklyPlan[]
  events       InterviewEvent[]
}

model Application {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  jobRole            String
  positionType       String    @default("Permanent")
  expectedExperience String?
  location           String?
  wfhMode            String?
  appliedOn          DateTime  @default(now())
  source             String?
  appStatus          String    @default("Applied")
  telephonicRound    String    @default("Pending")
  technicalRound1    String    @default("Pending")
  technicalRound2    String    @default("Pending")
  hrRound            String    @default("Pending")
  currentStage       String?
  ctcExpected        String?
  ctcOffered         String?
  noticePeriod       String?
  offerDeadline      DateTime?
  followUpOn         DateTime?
  interviewNotes     String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  events             InterviewEvent[]
}

model Company {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName  String
  location     String?
  wfhPolicy    String?
  techStack    String?
  careersPage  String?
  linkedinPage String?
  priority     String   @default("Medium")
  applied      String   @default("No")
  notes        String?
  createdAt    DateTime @default(now())
}

model WeeklyPlan {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekNumber        Int
  day               String
  applyTarget       Int      @default(3)
  companiesToTarget String?
  followUpNeeded    String?
  prepTopic         String?
  linkedinActions   String?
  status            String   @default("Planned")
  notes             String?
  createdAt         DateTime @default(now())
}

model InterviewEvent {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  title         String
  companyName   String
  roundType     String       @default("General")
  eventDate     DateTime
  startTime     String
  endTime       String
  notes         String?
  color         String       @default("#4669FA")
  meetingLink   String?
  interviewer   String?
  reminderMins  Int          @default(30)
  status        String       @default("Scheduled")
  createdAt     DateTime     @default(now())
}
